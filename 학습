plt.show()

# 📌 7. 모델 저장 (HDF5 또는 SavedModel)
model.save("person_detection_model")

# 📌 8. TFLite 모델 변환 및 저장
converter = tf.lite.TFLiteConverter.from_saved_model("person_detection_model")
tflite_model = converter.convert()
with open("person_detection_model.tflite", "wb") as f:
    f.write(tflite_model)

# 📌 9. TFLite 양자화 모델 변환 (int8 양자화 예시)
def representative_dataset():
    for i in range(100):
        yield [np.expand_dims(X_train[i], axis=0)]

converter.optimizations = [tf.lite.Optimize.DEFAULT]
converter.representative_dataset = representative_dataset
converter.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS_INT8]
converter.inference_input_type = tf.uint8
converter.inference_output_type = tf.uint8

quant_model = converter.convert()
with open("person_detection_model_quant.tflite", "wb") as f:
    f.write(quant_model)
